{
  "name": "zcode-context",
  "version": "0.3.8",
  "description": "只读查看会话用量、模型输入组成、请求差异和压缩事件。",
  "description_i18n": {
    "en": "Read-only session usage, model input composition, request differences and compaction events.",
    "zh-CN": "只读查看会话用量、模型输入组成、请求差异和压缩事件。"
  },
  "author": {
    "name": "Kevinzzz6"
  },
  "license": "MIT",
  "userConfig": {
    "dataRoot": {
      "type": "string",
      "title": "ZCode CLI data directory",
      "description": "Optional directory containing db/, rollout/ and log/. Empty uses ~/.zcode/cli.",
      "default": ""
    },
    "dbPath": {
      "type": "string",
      "title": "Session database",
      "description": "Optional absolute session database path.",
      "default": ""
    }
  },
  "mcpServers": {
    "context": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/dist/server.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_CONTEXT_DATA_ROOT": "${user_config.dataRoot}",
        "ZCODE_CONTEXT_DB_PATH": "${user_config.dbPath}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "context",
        "title": {
          "zh-CN": "上下文",
          "en-US": "Context"
        },
        "icon": "chart-column",
        "server": "context",
        "resourceUri": "ui://zcode-context/panel.html",
        "availability": "session"
      }
    ]
  }
}
